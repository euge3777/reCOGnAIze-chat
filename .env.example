# Environment configuration
# OpenAI API Configuration
OPENAI_API_KEY=

# Optional: Specify which OpenAI model to use (default: gpt-4)
# OPENAI_MODEL=gpt-4

# Vector Database Configuration (Qdrant)
# For local in-memory: leave QDRANT_URL and QDRANT_API_KEY empty
# For local persistent: set QDRANT_URL=http://localhost:6333
# For Qdrant Cloud: set QDRANT_URL=https://your-instance.qdrant.io:6333 and QDRANT_API_KEY=your_api_key
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=cognitive_health

# Embedding model settings
EMBEDDING_MODEL=text-embedding-3-small

# Cognitive analysis settings
DEFAULT_AGE=35
DEFAULT_GENDER=unknown

# Recommendation settings
MAX_RECOMMENDATIONS=10
MIN_SIMILARITY_SCORE=0.7

# UI settings
PAGE_TITLE=ReCOGnAIze Cognitive Health Companion
PAGE_ICON=brain

# Logging
LOG_LEVEL=INFO